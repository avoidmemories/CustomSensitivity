<Application x:Class="CustomSensitivity.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <Color x:Key="AccentColor">#FFEC9A2A</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#FFF5F5F5" />
      <Setter Property="Background" Value="#FF161616" />
      <Setter Property="BorderBrush" Value="#FF353535" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="Border" Property="Background" Value="#FF202020" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Border" Property="Background" Value="{StaticResource AccentBrush}" /><Setter Property="Foreground" Value="#FF111111" /></Trigger>
              <!-- A completed Apply button must remain green even while the
                   pointer is over it; this trigger intentionally follows the
                   generic hover/pressed states. -->
              <Trigger Property="Tag" Value="success">
                <Setter TargetName="Border" Property="Background" Value="#FF4B974E" />
                <Setter TargetName="Border" Property="BorderBrush" Value="#FF69B46C" />
                <Setter Property="Foreground" Value="#FFFFFFFF" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Border" Property="Opacity" Value="0.35" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
